#!/bin/bash
# Opens Banana King 3D (index.html next to this app) in the default web browser.
GAME="$(cd "$(dirname "$0")/../../.." && pwd)/index.html"
if [ -n "$DRY_RUN" ]; then echo "$GAME"; exit 0; fi
if [ -f "$GAME" ]; then
  open "$GAME"
else
  osascript -e 'display alert "Banana King 3D" message "Could not find index.html next to this app. Keep the app inside the Banana King 3D folder."'
fi
